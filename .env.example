# Copiar a .env y completar con los valores del proyecto de Firebase (Consola → Configuración del proyecto).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emails con Super Admin garantizado (separados por coma). Evita quedar sin acceso a Users/Roles si el rol en Firestore está incompleto.
VITE_OWNER_EMAILS=
